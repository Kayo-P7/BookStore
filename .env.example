# configuracao do banco de dados postgresql
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# conexao spring datasource para os microsservicos
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bookstore
SPRING_DATASOURCE_USERNAME=bookstore
SPRING_DATASOURCE_PASSWORD=bookstore

# portas dos microsservicos backend
CATALOG_SERVICE_PORT=8081
CUSTOMER_SERVICE_PORT=8082
SALES_SERVICE_PORT=8083
LOAN_SERVICE_PORT=8085

# comunicacao interna entre microsservicos
CATALOG_URL=http://localhost:8081
CUSTOMER_URL=http://localhost:8082

# seguranca e token jwt
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# portas do gateway nginx e dos frontends
