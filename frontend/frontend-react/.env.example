# comunicacao com modulo vue (logistica e calendario)
# em producao na vps, aponte para a porta ou dominio do vue (ex: http://IP_DA_VPS:8090)
# se omitido, o sistema detecta automaticamente o host atual na porta 8090
VITE_VUE_URL=http://localhost:5174

# porta de execucao local do vite
REACT_PORT=5173

# urls dos microsservicos backend para proxy de desenvolvimento
GATEWAY_URL=http://localhost:8080
CATALOG_URL=http://localhost:8081
CUSTOMER_URL=http://localhost:8082
SALES_URL=http://localhost:8083
LOAN_URL=http://localhost:8085
