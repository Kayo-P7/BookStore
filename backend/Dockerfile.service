FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml .
COPY security-common/pom.xml security-common/pom.xml
COPY catalog-service/pom.xml catalog-service/pom.xml
COPY customer-service/pom.xml customer-service/pom.xml
COPY sales-service/pom.xml sales-service/pom.xml
COPY loan-service/pom.xml loan-service/pom.xml
ARG MODULE
RUN mvn -B -q -pl ${MODULE} -am dependency:go-offline
COPY security-common/src security-common/src
COPY catalog-service/src catalog-service/src
COPY customer-service/src customer-service/src
COPY sales-service/src sales-service/src
COPY loan-service/src loan-service/src
RUN mvn -B -q -pl ${MODULE} -am package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
ARG MODULE
COPY --from=build /workspace/${MODULE}/target/${MODULE}-1.0.0.jar app.jar
EXPOSE 8081 8082 8083 8085
ENTRYPOINT ["java","-XX:MaxRAMPercentage=75.0","-XX:+UseStringDeduplication","-jar","/app/app.jar"]
